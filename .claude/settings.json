{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "cargo test 2>&1",
            "timeout": 120,
            "statusMessage": "Running tests before push..."
          }
        ]
      }
    ]
  }
}
